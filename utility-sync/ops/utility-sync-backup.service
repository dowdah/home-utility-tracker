[Unit]
Description=Create and verify a Utility Sync SQLite backup
After=utility-sync.service

[Service]
Type=oneshot
User=utility-sync
Group=utility-sync
WorkingDirectory=/opt/utility-sync
EnvironmentFile=/etc/utility-sync/environment
ExecStart=/usr/local/bin/uv run --frozen --no-sync utility-sync backup
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/utility-meter
UMask=0077
