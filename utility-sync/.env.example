# All paths must be private to the utility-sync service account and must not be SMB writable.
UTILITY_SYNC_DATA_DIR=/srv/utility-meter/data
UTILITY_SYNC_EXPORTS_DIR=/srv/utility-meter/exports
UTILITY_SYNC_BACKUPS_DIR=/srv/utility-meter/backups
UTILITY_SYNC_DATABASE=/srv/utility-meter/data/utility.sqlite3
UTILITY_SYNC_LOG_LEVEL=INFO
# Bytes. 10 GiB protects writes from host-wide disk pressure, not backup storage size.
UTILITY_SYNC_WRITE_MIN_FREE_BYTES=10737418240
# A new online backup needs 256 MiB free on the backup filesystem; published backups total at most 128 MiB.
UTILITY_SYNC_BACKUP_MIN_FREE_BYTES=268435456
UTILITY_SYNC_BACKUP_MAX_BYTES=134217728
